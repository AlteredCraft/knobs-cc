{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default-linux",
  "description": "Linux-only opener scopes for the system-wide managed-tier path under /etc/claude-code/.",
  "platforms": ["linux"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "/etc/claude-code/**" }
      ]
    }
  ]
}
